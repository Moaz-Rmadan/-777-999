{
  "entities": {
    "User": {
      "title": "User",
      "description": "User entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name", "username", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stock": { "type": "number" }
      },
      "required": ["id", "name", "stock"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product documents"
    }
  }
}
