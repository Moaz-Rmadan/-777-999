rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened system_data collection
    match /system_data/{documentId} {
      allow read: if isSignedIn() && isEmailVerified();
      allow write: if isSignedIn() && isEmailVerified();
    }
  }
}
