rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety catch-all net
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure system_data collection - only allow authenticated SSO employees
    match /system_data/{documentId} {
      allow read, write: if request.auth != null;
    }
  }
}
